<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0b0a09">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {{ 'playfair-display-variable.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'archivo-variable.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>

  {%- comment -%}
    World assignment (§2): a product's own world is set by the
    `lu.world` metafield ("cream" | "dark"); every other template falls
    back to whatever the visitor last chose, persisted client-side by
    world-switch.js, defaulting to cream. The switch on every page lets a
    visitor cross over at any point.
  {%- endcomment -%}
  {%- liquid
    assign body_world = 'cream'
    if template.name == 'product' and product.metafields.lu.world.value != blank
      assign body_world = product.metafields.lu.world.value
    endif
  -%}
  <body
    class="world-{{ body_world }}"
    data-world="{{ body_world }}"
    data-default-world="cream"
    {%- if template.name == 'product' %} data-force-world="{{ body_world }}"{% endif %}
  >
    <a class="visually-hidden skip-link" href="#MainContent">Skip to content</a>

    {% section 'header' %}

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <script src="{{ 'world-switch.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'scroll-fade.js' | asset_url }}" defer="defer"></script>
    {%- if template.name == 'product' -%}
      <script src="{{ 'product-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </body>
</html>
