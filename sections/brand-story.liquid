<section class="brand-story">
  <div class="brand-story__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="t-label brand-story__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="t-h1 brand-story__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="t-body brand-story__body">{{ section.settings.body }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The house"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Two fragrances, one house"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy"
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
