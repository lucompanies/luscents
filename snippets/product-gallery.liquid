{%- doc -%}
  Mobile: swipeable via scroll-snap. Desktop: sticky column, not a
  carousel (§4). Tap the macro/detail shot to toggle a zoomed view.
  @param product {product}
{%- enddoc -%}
<div class="product__gallery" data-product-gallery>
  {%- for image in product.images -%}
    <div class="product__gallery-item" data-gallery-item>
      {{
        image
        | image_url: width: 1400
        | image_tag:
          loading: image.first == true or forloop.first ? 'eager' : 'lazy',
          fetchpriority: forloop.first ? 'high' : 'auto',
          sizes: '(min-width: 900px) 55vw, 92vw',
          widths: '480,768,1080,1400',
          alt: image.alt | default: product.title
      }}
    </div>
  {%- else -%}
    <div class="product__gallery-item">
      {{ 'product-1' | placeholder_svg_tag }}
    </div>
  {%- endfor -%}
</div>
